# DGSM environment configuration template.
# Copy values into your shell/session or your secret manager. DGSM deliberately
# does not auto-load .env files from the current working directory.

# Optional Globalping API token. Public anonymous probes work without a token.
GLOBALPING_API_TOKEN=

# Optional comma-separated IDs of existing RIPE Atlas measurements that
# actually target Discord endpoints. DGSM reads their latest results only;
# it never creates measurements or spends measurement credits.
RIPE_ATLAS_MEASUREMENT_IDS=

# Optional API key for authorized/private RIPE Atlas result access.
# Never commit a real key.
RIPE_ATLAS_API_KEY=
